# Keycloak (existing tools: create_document, list_documents, read_document,
# write_document, delete_document, share_document)
KEYCLOAK_URL=http://localhost:8083/realms/example-realm
KEYCLOAK_CLIENT_ID=example-client-id
KEYCLOAK_CLIENT_SECRET=example-client-secret
KEYCLOAK_USERNAME=example-user
KEYCLOAK_PASSWORD=example-password

# La Suite Docs server-to-server (create_document_as_owner only — see
# core/integrations/la_suite_docs_client.py)
LA_SUITE_DOCS_BASE_URL=http://localhost:18071/api/v1.0
LA_SUITE_DOCS_TOKEN=example-token
LA_SUITE_DOCS_OWNER_SUB=example-owner-sub
LA_SUITE_DOCS_OWNER_EMAIL=example-owner@example.com

# Selects the transcript source implementation.
# Only "fixture" is implemented today (no confirmed Meet/Visio API/endpoint
# exists yet). Any other value causes a clear error instead of a silent
# fallback to the fixture.
MEET_SOURCE=fixture

# Path to a local .txt or .md transcript file used in fixture/demo mode.
# Defaults to samples/conseil_municipal_transcript.txt at the repo root if unset.
MEET_TRANSCRIPT_FIXTURE_PATH=../../samples/conseil_municipal_transcript.txt
